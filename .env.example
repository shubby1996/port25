# mock = no credentials, always works. Use this until the 00:50 gate.
# ambiguous = primary target.  smtp = fallback if the gate fails.
PORT25_TRANSPORT=mock

OPENAI_API_KEY=
OPENROUTER_API_KEY=
EXA_API_KEY=
# AI-assisted wording and classification within the paired demo's price rules.
PORT25_DEMO_AI=false

# PORT25_TRANSPORT=ambiguous
AMBIGUOUS_API_KEY=
AMBIGUOUS_OUR_AGENT_ID=
AMBIGUOUS_THEIR_AGENT_ID=
# Not published anywhere public — get this from your Ambiguous workspace's
# API settings. Used only by POST /coworkers (provision_coworker).
AMBIGUOUS_API_BASE=

# POST /coworkers requires a valid Auth0 access token once both are set.
# Leave blank and that endpoint is open (everything else is unaffected).
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# PORT25_TRANSPORT=smtp (our Gmail inbox uses an app password)
# COUNTERPARTY_EMAIL is a second inbox that replies to the test/negotiation.
OUR_EMAIL=
OUR_EMAIL_APP_PASSWORD=
COUNTERPARTY_EMAIL=
SMTP_HOST=smtp.gmail.com
# 465 uses implicit TLS; 587 uses STARTTLS.
SMTP_PORT=465
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
PORT25_DEMO_PAIR=false
COUNTERPARTY_EMAIL_APP_PASSWORD=
